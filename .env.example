# ==============================================================================
# Colab Router - Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' or token files to version control!
# ==============================================================================

# ----------------- Ingress & Networking -----------------
# Get your free Ngrok auth token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# (Optional) If you have a free or paid reserved static domain on Ngrok:
# e.g., my-awesome-colab.ngrok-free.dev (leave blank for dynamic random URL)
NGROK_DOMAIN=your_custom_domain_here.ngrok-free.dev

# ----------------- Security & API Keys -----------------
# The master API key clients must send in header: Authorization: Bearer <API_KEY>
GDQ_API_KEY=sk-gdq-master-secret-key

# Optional Master Passkey for the web gateway login gate
GDQ_PASSKEY=your_secure_passkey_123

# Optional fallback provider (e.g. Groq) while Colab model is warming up
GROQ_API_KEY=your_optional_groq_api_key

# ----------------- AI Model Configuration -----------------
# Choose ONE model block below. Only Qwen 3.8 27B is the main tested model.
# The other two are small, older models. They are NOT DeepSeek V4 / GLM-5 (those need hundreds of GB).

# --- [Default] Option 1: Qwen 3.8 27B Uncensored (IQ4_XS - 14.3GB, Zero Refusals, High IQ) ---
HF_MODEL_URL=https://huggingface.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF/resolve/main/Qwen3.8-27B-Uncensored-IQ4_XS.gguf
MODEL_FILENAME=Qwen3.8-27B-Uncensored-IQ4_XS.gguf
OLLAMA_MODEL_TAG=qwen3.8-27b-uncensored
NUM_CTX=4096
NUM_PREDICT=4096

# --- Option 2: DeepSeek-R1 Distill Qwen 14B (a Qwen model trained on R1 outputs, not DeepSeek V4) (Q4_K_M - 9.0GB, Live <think> Reasoning Stream) ---
# HF_MODEL_URL=https://huggingface.co/bartowski/DeepSeek-R1-Distill-Qwen-14B-GGUF/resolve/main/DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf
# MODEL_FILENAME=DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf
# OLLAMA_MODEL_TAG=deepseek-r1-14b
# NUM_CTX=8192
# NUM_PREDICT=8192

# --- Option 3: GLM-4 9B Chat (small older GLM, not GLM-5) (Q4_K_M - 5.8GB, Ultra Fast, 32K Context, Deep Refactoring) ---
# HF_MODEL_URL=https://huggingface.co/bartowski/glm-4-9b-chat-GGUF/resolve/main/glm-4-9b-chat-Q4_K_M.gguf
# MODEL_FILENAME=glm-4-9b-chat-Q4_K_M.gguf
# OLLAMA_MODEL_TAG=glm-4-9b-chat
# NUM_CTX=16384
# NUM_PREDICT=8192

# ----------------- Orchestrator Shift Management -----------------
# Accounts used by the orchestrator. 1 = single account, no rotation (recommended).
# Colab FAQ disallows using multiple accounts to work around limits. Set 2+ only at your own risk.
ACCOUNT_COUNT=1

# Only used when ACCOUNT_COUNT > 1: hours before handing over to the next account
SHIFT_MAX_HOURS=3.5

# When Google has no free GPU, wait 5, 10, 20, 40 ... min (cap 60 min) before retrying
BACKOFF_BASE_SECONDS=300
BACKOFF_MAX_SECONDS=3600

# Optional GPU pulse inside Colab. OFF by default (does not prevent session limits)
# KEEPALIVE_PULSE=1

# Health probe check frequency in seconds
HEALTH_CHECK_INTERVAL=30

# Maximum consecutive health failures before triggering failover rotation
CONSECUTIVE_FAILURES_LIMIT=5

# Port for Cloud Keep-Alive & Health Server (for Render / Koyeb / Docker)
PORT=8080

# Vault directory storing Google Colab OAuth tokens (per-account subfolders)
VAULT_DIR=./vault
